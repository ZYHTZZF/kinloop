# 环境变量配置示例
# 复制此文件为 .env.local，并填入实际的凭证
# 注意：.env.local 不会提交到 Git 仓库

# ===== 火山引擎配置 =====
# API Key - 从火山引擎控制台获取
VITE_VOLCANO_API_KEY=your_api_key_here

# 账户标识
VITE_VOLCANO_ACCOUNT=your_account_here

# 服务端 API Key（与 VITE_VOLCANO_API_KEY 相同）
KINLOOP_VOLCANO_API_KEY=your_api_key_here

# ===== 服务器配置 =====
# API 服务器监听端口
KINLOOP_API_PORT=8787

# API 服务器监听地址
KINLOOP_API_HOST=127.0.0.1

# 数据库文件路径（相对于项目根目录）
KINLOOP_DB_PATH=data/kinloop.db

# ===== 开发配置 =====
# 日志级别 (debug | info | warn | error)
LOG_LEVEL=debug

# 调试模式
DEBUG=1
