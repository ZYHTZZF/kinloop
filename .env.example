# 环境变量配置示例
# 复制此文件为 .env.local，并填入实际的凭证
# 注意：.env.local 不会提交到 Git 仓库

# ===== 火山引擎配置 =====
# API Key - 从火山引擎控制台获取
VITE_VOLCANO_API_KEY=your_api_key_here

# 账户标识
VITE_VOLCANO_ACCOUNT=your_account_here

# 服务端 API Key（与 VITE_VOLCANO_API_KEY 相同）
KINLOOP_VOLCANO_API_KEY=your_api_key_here
KINLOOP_VOLC_TTS_API_KEY=your_volc_tts_api_key
KINLOOP_VOLC_TTS_APP_ID=your_volc_tts_app_id
KINLOOP_VOLC_TTS_ACCESS_TOKEN=your_volc_tts_access_token
KINLOOP_VOLC_TTS_CLUSTER=volcano_tts
KINLOOP_VOLC_TTS_VOICE_TYPE=BV700_streaming
KINLOOP_TENCENT_TTS_APP_ID=your_tencent_tts_app_id
KINLOOP_TENCENT_TTS_SECRET_ID=your_tencent_tts_secret_id
KINLOOP_TENCENT_TTS_SECRET_KEY=your_tencent_tts_secret_key
KINLOOP_TENCENT_TTS_REGION=ap-guangzhou
KINLOOP_TENCENT_TTS_VOICE_TYPE=101001

# ===== 服务器配置 =====
# API 服务器监听端口
KINLOOP_API_PORT=8787

# API 服务器监听地址
KINLOOP_API_HOST=127.0.0.1

# 数据库文件路径（相对于项目根目录）
KINLOOP_DB_PATH=data/kinloop.db

# ===== 开发配置 =====
# 日志级别 (debug | info | warn | error)
LOG_LEVEL=debug

# 调试模式
DEBUG=1

# ===== LLM Intent Parsing =====
# Server-side model key for intent parsing (recommended)
KINLOOP_LLM_API_KEY=your_llm_api_key_here

# OpenAI-compatible base URL (Volcengine Ark example)
KINLOOP_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Model ID used for intent extraction
KINLOOP_LLM_MODEL=your_model_id_here

# ASR model ID used by /api/asr/transcribe (e.g. whisper model on your provider)
KINLOOP_ASR_MODEL=your_asr_model_id_here

# Volcengine ASR (openspeech flash recognize)
KINLOOP_VOLC_ASR_APP_ID=your_volc_asr_app_id
KINLOOP_VOLC_ASR_ACCESS_TOKEN=your_volc_asr_access_token
KINLOOP_VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# ===== Hume Voice Tone =====
# Fill these two values to enable real Hume prosody analysis for voice emotion.
HUME_API_KEY=your_hume_personal_api_key
HUME_SECRET_KEY=your_hume_secret_key

# ===== Web / Android runtime =====
# Web 开发环境通常无需填写，Android 真机请改成可访问的后端地址
VITE_API_BASE_URL=http://127.0.0.1:8787

# 可选，默认会按 API 主机自动推导；如信令/WS 地址不同可单独指定
VITE_WS_BASE_URL=ws://127.0.0.1:8787

# 可选，默认是 /api
VITE_API_BASE_PATH=/api

# ===== Auth / Email =====
KINLOOP_SMTP_HOST=smtp.example.com
KINLOOP_SMTP_PORT=465
KINLOOP_SMTP_SECURE=true
KINLOOP_SMTP_REQUIRE_TLS=true
KINLOOP_SMTP_USER=your_smtp_user@example.com
KINLOOP_SMTP_PASS=your_smtp_password
KINLOOP_SMTP_FROM=Kinloop <no-reply@example.com>
KINLOOP_AUTH_SESSION_TTL_MS=2592000000
KINLOOP_AUTH_CODE_TTL_MS=600000
KINLOOP_AUTH_DEV_EXPOSE_CODES=false
